        "jsCode": "// 1. Filter rows that are NOT processed yet (PersianScript is empty)\nconst unprocessed = $input.all().filter(item => {\n  const script = item.json.PersianScript;\n  return !script || script.toString().trim() === '';\n});\n\n// 2. Sort by Likes (Highest first)\nunprocessed.sort((a, b) => {\n  const likeA = parseInt(a.json.Like || 0);\n  const likeB = parseInt(b.json.Like || 0);\n  return likeB - likeA;\n});\n\n// 3. Pick the top 1\nif (unprocessed.length > 0) {\n  return [unprocessed[0]];\n} else {\n  return []; // Stop if nothing to process\n}"
