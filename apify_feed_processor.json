    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all().map(i => i.json);\n\n// تابع جستجوی پیشرفته لینک (حتی اگر اسم کلید عجیب باشد)\nconst findLink = (item) => {\n  // 1. چک کردن کلیدهای استاندارد\n  if (item.VideoURL) return item.VideoURL;\n  if (item.videoUrl) return item.videoUrl;\n  if (item.postUrl) return item.postUrl;\n  if (item.url) return item.url;\n  if (item.link) return item.link;\n  if (item.canonicalUrl) return item.canonicalUrl;\n  \n  // 2. چک کردن کلیدهای شروع شونده با https (اگر کلید پیدا نشد)\n  for (const key in item) {\n    if (typeof item[key] === 'string' && item[key].startsWith('https://www.instagram.com/')) {\n      return item[key];\n    }\n  }\n  return null;\n};\n\nconst validItems = items.filter(item => {\n  const link = findLink(item);\n  // ذخیره لینک پیدا شده در خود آیتم برای استفاده‌های بعدی\n  if (link) item.finalLink = link; \n  return link && link.toString().trim() !== '';\n});\n\n// سورت کردن\nvalidItems.sort((a, b) => parseInt(b.Like || b.likeCount || 0) - parseInt(a.Like || a.likeCount || 0));\n\nconst top10 = validItems.slice(0, 10);\n\n// --- تولید HTML ---\nlet html = `<div style=\"font-family: Arial, sans-serif; direction: ltr;\">\n<h3 style=\"color:#E1306C\">نتایج یافت شده (${top10.length} مورد):</h3>\n<table style=\"width:100%; border-collapse:collapse;\">\n<thead><tr style=\"background:#eee\"><th style=\"padding:10px\">Post</th><th style=\"padding:10px\">Likes</th><th style=\"padding:10px\">Link</th></tr></thead><tbody>`;\n\nfor (const item of top10) {\n  const caption = (item.Caption || item.caption || item.text || '').substring(0, 50) + '...';\n  const likes = parseInt(item.Like || item.likeCount || 0).toLocaleString();\n  const hashtag = item.searchedHashtag || '';\n  \n  html += `\n  <tr style=\"border-bottom:1px solid #ddd\">\n    <td style=\"padding:10px\"><b>${caption}</b><br><span style=\"color:#888;font-size:12px\">${hashtag}</span></td>\n    <td style=\"padding:10px\"><b>${likes}</b></td>\n    <td style=\"padding:10px\"><a href=\"${item.finalLink}\" style=\"color:#fff; background:#0095f6; padding:5px 10px; text-decoration:none; border-radius:4px\">View</a></td>\n  </tr>`;\n}\nhtml += `</tbody></table></div>`;\n\nreturn [{\n  json: {\n    subject: `🚀 ۱۰ ریلز وایرال - ${new Date().toLocaleDateString()}`,\n    html_body: html,\n    count: top10.length,\n    debug_first_item: items[0] // برای اطمینان نمونه داده را هم در خروجی می‌گذاریم\n  }\n}];",
        "notice": ""
      },
      "id": "fe5485f4-8a37-4e0b-9841-c4a445e666c2",
      "name": "Format Email1",
