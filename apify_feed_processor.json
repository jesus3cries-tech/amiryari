    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const allItems = $input.all();\nconst existingIds = new Set();\nconst newCandidates = [];\n\n// Helper to extract Instagram ShortCode\nfunction getShortCode(url) {\n    if (!url) return null;\n    // Match /p/CODE, /reel/CODE, /tv/CODE\n    // Normalize by splitting by ? to remove query params first\n    const cleanUrl = url.split('?')[0].replace(/\\/$/, '');\n    const parts = cleanUrl.split('/');\n    return parts[parts.length - 1];\n}\n\n// First pass: Archive items\nfor (const item of allItems) {\n    const json = item.json;\n    // Check for existing archive items (have VideoURL)\n    if (json.VideoURL && !json['Post URL']) {\n        const sc = getShortCode(json.VideoURL);\n        if (sc) existingIds.add(sc);\n    }\n    // Check for new items (have Post URL from Success Output)\n    else if (json['Post URL']) {\n        newCandidates.push(item);\n    }\n}\n\nconst uniqueItems = [];\n\n// Second pass: Filter new candidates\nfor (const item of newCandidates) {\n    const rawUrl = item.json['Post URL'];\n    const sc = getShortCode(rawUrl);\n    \n    // Uniqueness check: Must have a shortcode AND not be in existing set\n    if (sc && !existingIds.has(sc)) {\n        uniqueItems.push({\n            json: {\n                VideoURL: rawUrl,\n                Caption: item.json.Caption,\n                Like: item.json.Likes,\n                CM: item.json.Comments,\n                View: item.json.Views || 0,\n                Date: new Date().toISOString().split('T')[0],\n                searchedHashtag: item.json.searchedHashtag\n            }\n        });\n        // Add to set to prevent duplicates within the new batch itself\n        existingIds.add(sc);\n    }\n}\n\nreturn uniqueItems;",
        "notice": ""
      },
